---
import { cn, sluglify } from '@/utils'

const { name = 'View All', activeCategory } = Astro.props
const currentPath = Astro.url.pathname
const unsluglifyNameCategory = sluglify(name.toLowerCase())
const isViewAll = name === 'View All'
const viewAllHref = '/blog'

const isActive =
	activeCategory?.toLocaleLowerCase() === unsluglifyNameCategory ||
	(isViewAll && (currentPath === viewAllHref || currentPath === `${viewAllHref}/`))
---

<a
	href={isViewAll ? viewAllHref : sluglify(`/category/${unsluglifyNameCategory}/1`)}
	class={cn(
		`text-gray-600  pb-2.5 first-letter:uppercase font-medium hover:text-gray-800 border-b-2 border-opacity-0 border-black hover:border-opacity-100 transition-colors duration-150 ease-linear  `,
		isActive && `border-black border-b-2 text-black z-10 border-opacity-100`
	)}
>
	{name}
</a>
