---
import BaseLayout from '@/layouts/BaseLayout'
import ListCategories from '@/components/ListCategories'
import StoryPostList from '@/components/StoryPostList'
import TitlePage from '@/components/TitlePage'
import { getPosts } from '@/utils'

const posts = (await getPosts()).filter((post) => {
	const normalizedCategory = post.data.category.toLowerCase()
	return (
		normalizedCategory !== 'portfolio' &&
		normalizedCategory !== 'research' &&
		normalizedCategory !== 'resume'
	)
})
---

<BaseLayout title='Blog'>
	<TitlePage title='Blog' />
	<p class='mt-3 max-w-3xl text-base text-gray-700'>
		Notes, essays, and technical writing outside the portfolio and research tracks.
	</p>
	<section class='mt-6 max-w-3xl text-base text-gray-700' aria-labelledby='blog-work-in-progress'>
		<h2 id='blog-work-in-progress' class='font-semibold text-gray-900'>
			Work in progress
		</h2>
		<p class='mt-2'>
			Confession: I initially generated most of the content for these posts using AI without asking
			whether they brought any value to the people reading them or to myself. I'll be publishing
			them once again with 0 AI, all me. They'll be a bit rough around the edges, but I hope they'll
			be much more worth reading. Maybe you'll learn something new about the topic, or about me.
		</p>
		<p class='mt-2'>
			Thanks for coming by. Feel free to email me at
			<a class='underline' href='mailto:rahman.aryan07@gmail.com'>
				rahman.aryan07@gmail.com
			</a>
			if you want to talk about a post.
		</p>
	</section>
	<div class='mt-6'>
		<ListCategories />
	</div>

	<StoryPostList
		posts={posts}
		ctaLabel='Read'
		showCategory={true}
		emptyMessage='Blog posts are coming soon.'
	/>
</BaseLayout>
